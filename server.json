{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Tthanh2k6/remote-contract-jobs",
  "description": "Remote contract and part-time dev jobs from public feeds, minus location, video and ID blockers.",
  "repository": {
    "url": "https://github.com/Tthanh2k6/remote-contract-jobs",
    "source": "github"
  },
  "version": "0.1.2",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "remote-contract-jobs",
      "version": "0.1.2",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--with",
          "value": "mcp>=1.2"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
